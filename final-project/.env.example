# =============================================================================
# NTU-COOL Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# Backend Configuration (SHADOW_ prefix)
# =============================================================================

# Building dataset path (used when SHADOW_USE_SUPABASE=false)
SHADOW_BUILDING_DATASET=data/4342.json

# Timezone for solar position calculations
SHADOW_TIMEZONE=Asia/Taipei

# Use Supabase database for building queries (recommended for production)
SHADOW_USE_SUPABASE=true

# Use Mapbox Directions API for routing (optional)
SHADOW_USE_MAPBOX_ROUTING=false
SHADOW_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
SHADOW_MAPBOX_ROUTING_PROFILE=walking

# Routing algorithm parameters
SHADOW_BOUNDING_BOX_BUFFER_M=150.0
SHADOW_SAMPLE_SPACING_M=15.0
SHADOW_ALPHA=0.5
SHADOW_DEFAULT_HEIGHT_M=20.0

# Cache configuration
SHADOW_CACHE_TTL_SECONDS=3600
SHADOW_CACHE_SIZE=32
SHADOW_REQUEST_TIMEOUT_SECONDS=60.0
SHADOW_CACHE_DISTANCE_THRESHOLD_M=5.0
SHADOW_CACHE_TIME_THRESHOLD_MINUTES=20.0
SHADOW_CACHE_DIR=cache

# =============================================================================
# Supabase Database Configuration
# =============================================================================
# Get these from: Supabase Dashboard → Settings → API
# Required if SHADOW_USE_SUPABASE=true

SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Database connection (for direct PostgreSQL access, optional)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
DATABASE_URL=YOUR_DATABASE_URL

SHADOW_USE_SUPABASE_STREET_GRAPH=true

SHADOW_PRECOMPUTEe_ENABLED=true

# =============================================================================
# Frontend Configuration (VITE_ prefix)
# =============================================================================
# Note: Frontend reads from frontend/.env, but you can also set these here
# for convenience. Vite only reads variables prefixed with VITE_

# Mapbox Access Token (required)
# Get from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# Google Maps API Key (optional, for place search and directions)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Geocoding API, Places API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# =============================================================================
# Mapbox Configuration (for test scripts)
# =============================================================================
# Used by database/scripts/test_mapbox_routing.py
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

SHADOW_USE_SUPABASE_STREET_GRAPH=true

SHADOW_PRECOMPUTE_ENABLED=true

SHADOW_USE_SUPABASE=true