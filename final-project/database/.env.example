# Supabase REST API Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Mapbox Directions API (for test scripts)
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# Mapbox Directions API (for backend service)
# Note: Backend uses SHADOW_ prefix (see backend/config.py)
SHADOW_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
SHADOW_USE_MAPBOX_ROUTING=false
SHADOW_MAPBOX_ROUTING_PROFILE=walking